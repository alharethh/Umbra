<Window x:Class="Umbra.Shell.Picker.WindowPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Umbra window picker"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        SizeToContent="Manual"

        Background="#FF000000"

        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False">

    <!--
        AllowsTransparency is deliberately absent. Setting it makes the window layered, and DWM
        will not composite a thumbnail onto a layered window — the picker would lay out perfectly
        and show nothing but empty rectangles. See DwmThumbnail's remarks.

        The 1 px edge is the one place §4's "no border" rule does not apply: this is a transient
        surface floating over arbitrary application content rather than a permanent strip against
        the screen edge, and without it the picker has no boundary at all over a dark window. It
        costs one pixel of #1A1A1A at Tier 2 duty.
    -->
    <Window.Resources>
        <!--
            The close button. Windows 11 turns its own close control red on hover rather than
            merely lightening it, which is the one control where "are you sure you are on the right
            thing" is worth answering unambiguously. Sized 22 rather than 18 so it is a comfortable
            target next to a 200 px thumbnail.
        -->
        <Style x:Key="PickerCloseButton" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#FF8A8A8A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FFC42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF8E1F14" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FF1A1A1A" BorderThickness="1" Background="#FF000000">
        <StackPanel x:Name="Columns" Orientation="Horizontal" Margin="12" />
    </Border>

</Window>
