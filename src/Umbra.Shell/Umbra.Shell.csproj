<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    ManagedShell's tasks service uses Windows Forms, and until this was here we were getting
    away with it: a framework-dependent build runs on a shared framework that carries WPF and
    Windows Forms together, so the assembly resolved at runtime without anyone asking for it.
    A self-contained build publishes only what is referenced, so it shipped without
    System.Windows.Forms and died on the first ShellManager with a FileNotFoundException
    naming it.

    The reference rather than <UseWindowsForms>, which turns on the whole SDK feature: its
    implicit usings collide with WPF on Application, ContextMenu, Brush and Color across this
    project, and its analysers reject the DPI awareness in app.manifest — which is
    load-bearing here, because every coordinate in this codebase is either physical or DIP on
    purpose. What is wanted is the assembly, not the programming model.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <!--
    The licences travel inside the binary, because one of the downloads is a single .exe with
    no files beside it. ManagedShell is Apache 2.0 and its assemblies are bundled into that
    file, and Apache 2.0 asks that whoever receives them receives the licence too — a link in
    a release note is not a copy. App writes them out beside the settings on first run.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="Umbra.LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.md" LogicalName="Umbra.THIRD-PARTY-NOTICES.md" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>Umbra</AssemblyName>
    <RootNamespace>Umbra.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Umbra's own windows - settings, the heatmap, the motion speed tool - appear on the
      taskbar, and without this they appear with the generic placeholder icon.
      Assets/logo.svg is the canonical artwork; umbra.ico is rendered from it at nine sizes.
    -->
    <ApplicationIcon>Assets\umbra.ico</ApplicationIcon>
    <!-- An application, not a library: no XML docs to generate. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ManagedShell" Version="0.0.370" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbra.Core\Umbra.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbra.Shell.Tests" />
  </ItemGroup>

  <!--
    The motion speed slider is a development instrument and a release build does not carry it.
    Its code-behind and every caller sit behind #if DEBUG; this removes the XAML half, which C#'s
    preprocessor cannot reach. Gated rather than deleted so development keeps the instrument.
    MotionSpeedGateTests checks the built assembly, BAML included, in both configurations.
  -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Page Remove="Motion\MotionSpeedWindow.xaml" />
  </ItemGroup>

</Project>
