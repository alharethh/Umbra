<Window x:Class="Umbra.Shell.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Umbra — settings"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="{DynamicResource Umbra.Background}"
        Foreground="{DynamicResource Umbra.Text}"
        TextOptions.TextRenderingMode="Grayscale"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.TextHint}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.Text}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.Text}" />
        </Style>

        <!--
            A full template, not just Background and Foreground setters. The window sets a light
            Foreground which inherits into the combo boxes, and WPF's stock ComboBox template draws
            its own light chrome regardless of Background — so the setters alone leave light-grey
            text on near-white, which is the least readable combination available. Verified by
            screenshotting the window rather than by assuming.
        -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.TextItem}" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Umbra.Highlight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.TextItem}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Face"
                                                Background="{DynamicResource Umbra.Control}"
                                                BorderBrush="{DynamicResource Umbra.Border}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Fill="{DynamicResource Umbra.Glyph}"
                                                  Data="M 0 0 L 7 0 L 3.5 4.5 Z" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Umbra.ControlHover}" />
                                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Umbra.BorderHover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="8,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="None"
                                   Focusable="False">
                                <Border Background="{DynamicResource Umbra.Surface}"
                                        BorderBrush="{DynamicResource Umbra.Border}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The page list. A ListBox rather than buttons, so arrow keys move between pages and
            UI Automation reports one selected item, as Windows 11's own Settings does. The
            accent bar is the logo's cyan, on the one item that is selected.
        -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.Text}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Background="{DynamicResource Umbra.Accent}" Visibility="Hidden" />
                            <Border x:Name="Focus" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="{DynamicResource Umbra.Accent}" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Umbra.NavHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Umbra.NavSelected}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Umbra.TextStrong}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows' own icon font, so the page icons match Windows 11's Settings. -->
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="2,0,10,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Umbra.TextStrong}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- A colour as text, and the colour itself beside it. -->
        <Style x:Key="HexBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Umbra.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Umbra.TextStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Umbra.Border}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Umbra.TextStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <!-- The swatch is a button: it opens the colour picker (SettingsWindow.OpenPicker). -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="18" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Umbra.Border}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" CornerRadius="3" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Umbra.Accent}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Umbra.Accent}" />
                                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            A theme in the list: a small picture of it, built in code (SettingsWindow.ThemeTile),
            with the selection drawn as a ring in the current window accent.
        -->
        <Style x:Key="ThemeTile" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Ring" BorderThickness="2" CornerRadius="8" Padding="1"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Umbra.BorderHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Umbra.TextStrong}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Umbra.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row of a page: a label column of fixed width, then the control. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <!--
        A page list on the left and one page at a time on the right, as Windows 11's own Settings
        is laid out. The single column this replaced had reached a 150% laptop's work area, and
        every new setting made it scroll.

        All five pages share one grid cell and the ones not shown are Hidden, not Collapsed, so
        the cell is always as tall as the tallest page: the window is one size whichever page is
        open, and never jumps when the user moves between them.

        The page area scrolls and the footer does not. WorkAreaFit caps the window at its
        monitor's work area; under the cap the scroll bar never appears. Over it, Close and Restart
        stay in the window and the page scrolls instead of running off the screen.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="{DynamicResource Umbra.Divider}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" Margin="8,14,8,8"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Settings pages">
                    <ListBoxItem AutomationProperties.Name="Bar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE90E;" />
                            <TextBlock Text="Bar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Wear">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE706;" />
                            <TextBlock Text="Wear" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Clock">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE823;" />
                            <TextBlock Text="Clock" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Themes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE790;" />
                            <TextBlock Text="Themes" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Hover">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE962;" />
                            <TextBlock Text="Hover" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Notification area">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE91C;" />
                            <TextBlock Text="Notification area" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <ScrollViewer x:Name="Body" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ScrollViewer.Resources>
                    <!--
                        Scoped to this viewer: the stock bar is light chrome on a dark window, the
                        same problem the ComboBox template above exists for. A thumb and nothing
                        else, like Windows 11's own overlay bars; the track either side still pages.
                    -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="MinWidth" Value="10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="{DynamicResource Umbra.Thumb}" CornerRadius="3" Margin="3,2" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid x:Name="Pages" Margin="22,16,22,10">

                    <!-- Bar -->
                    <StackPanel x:Name="BarPage">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Bar" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Screen edge" />
                            <ComboBox Grid.Column="1" x:Name="EdgeBox" AutomationProperties.Name="Screen edge" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon row" />
                            <ComboBox Grid.Column="1" x:Name="AlignmentBox" AutomationProperties.Name="Icon row" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor" />
                            <ComboBox Grid.Column="1" x:Name="MonitorBox" AutomationProperties.Name="Monitor" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,14"
                                   Text="All three apply at once. Moving the bar makes maximised windows resize to fit, which is expected." />

                        <CheckBox x:Name="EveryMonitorBox" Content="A bar on every monitor" Margin="0,0,0,2"
                                  ToolTip="A non-OLED second screen pays for the dim resting state and the monochrome icons and gets nothing back. The notification area stays on the primary monitor either way." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Only worth it if every screen is OLED. Needs a restart." />

                        <CheckBox x:Name="StartupBox" Content="Start Umbra when I sign in" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="For your account only. You can also turn it off in Task Manager's Startup tab." />
                    </StackPanel>

                    <!-- Wear -->
                    <StackPanel x:Name="WearPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Wear" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resting icon size" />
                            <Slider Grid.Column="1" x:Name="IconSize" VerticalAlignment="Center"
                                    Minimum="12" Maximum="24" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Resting icon size"
                                    ValueChanged="OnIconSizeChanged" />
                            <TextBlock Grid.Column="2" x:Name="IconSizeReadout"
                                       MinWidth="104" TextAlignment="Right" FontFamily="Consolas" FontSize="11" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resting brightness" />
                            <Slider Grid.Column="1" x:Name="Brightness" VerticalAlignment="Center"
                                    Minimum="10" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Resting brightness"
                                    ValueChanged="OnBrightnessChanged" />
                            <TextBlock Grid.Column="2" x:Name="BrightnessReadout"
                                       MinWidth="104" TextAlignment="Right" FontFamily="Consolas" FontSize="11" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,14"
                                   Text="Smaller and dimmer only at rest. Point at the bar and icons are full size and brightness." />

                        <CheckBox x:Name="MotionBox" Content="Drift and micro-jitter" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Moves the bar's contents inside their own slots, too slowly to see." />

                        <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Black when away" />
                            <ComboBox Grid.Column="1" x:Name="AwayBox" AutomationProperties.Name="Black when away" />
                            <StackPanel Grid.Column="2" x:Name="AwayCustom" Orientation="Horizontal"
                                        Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBox x:Name="AwaySeconds" Width="56" Style="{StaticResource HexBox}" TextAlignment="Right"
                                         AutomationProperties.Name="Black when away after this many seconds" />
                                <TextBlock Text="seconds" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,10"
                                   Text="Fades to black when there's no input. Stays lit while anything plays sound. Custom takes any number of seconds." />
                    </StackPanel>

                    <!-- Clock -->
                    <StackPanel x:Name="ClockPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Clock" />

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time format" />
                            <ComboBox Grid.Column="1" x:Name="ClockFormatBox" AutomationProperties.Name="Time format" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,10"
                                   Text="Follow Windows uses the format in Windows' region settings. On a left or right bar, a 12-hour clock leaves out AM and PM to fit." />
                    </StackPanel>

                    <!-- Themes -->
                    <StackPanel x:Name="ThemesPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Themes" />

                        <ListBox x:Name="ThemeList" Margin="-4,0,-4,2"
                                 Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource ThemeTile}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 AutomationProperties.Name="Themes">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <TextBlock x:Name="ThemeCustomNote" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Custom: these colours are not one of the themes above." />

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bar accent" />
                            <TextBox Grid.Column="1" x:Name="BarAccentHex" Style="{StaticResource HexBox}"
                                     AutomationProperties.Name="Bar accent hex value" />
                            <Button Grid.Column="2" x:Name="BarAccentSwatch" Style="{StaticResource Swatch}" ToolTip="Pick a colour" />
                        </Grid>
                        <Grid Style="{StaticResource Row}" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resting tint" />
                            <TextBox Grid.Column="1" x:Name="BarTintHex" Style="{StaticResource HexBox}"
                                     AutomationProperties.Name="Resting tint hex value" />
                            <Button Grid.Column="2" x:Name="BarTintSwatch" Style="{StaticResource Swatch}" ToolTip="Pick a colour" />
                        </Grid>
                        <Grid Style="{StaticResource Row}" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Window background" />
                            <TextBox Grid.Column="1" x:Name="WindowBackgroundHex" Style="{StaticResource HexBox}"
                                     AutomationProperties.Name="Window background hex value" />
                            <Button Grid.Column="2" x:Name="WindowBackgroundSwatch" Style="{StaticResource Swatch}" ToolTip="Pick a colour" />
                        </Grid>
                        <Grid Style="{StaticResource Row}" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Window text" />
                            <TextBox Grid.Column="1" x:Name="WindowTextHex" Style="{StaticResource HexBox}"
                                     AutomationProperties.Name="Window text hex value" />
                            <Button Grid.Column="2" x:Name="WindowTextSwatch" Style="{StaticResource Swatch}" ToolTip="Pick a colour" />
                        </Grid>
                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Window accent" />
                            <TextBox Grid.Column="1" x:Name="WindowAccentHex" Style="{StaticResource HexBox}"
                                     AutomationProperties.Name="Window accent hex value" />
                            <Button Grid.Column="2" x:Name="WindowAccentSwatch" Style="{StaticResource Swatch}" ToolTip="Pick a colour" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,10"
                                   Text="The bar stays black in every theme. Its accent is capped to the brightest a hover may be, and the tint keeps the resting icons at their own brightness, so no theme adds wear. A grey tint means none." />
                    </StackPanel>

                    <!-- Hover -->
                    <StackPanel x:Name="HoverPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Hover" />


                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Application icons" />
                            <ComboBox Grid.Column="1" x:Name="AppHoverBox" AutomationProperties.Name="Application icons hover" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Chip colour" />
                            <TextBox Grid.Column="1" x:Name="AppHoverHex" Style="{StaticResource HexBox}"
                                     AutomationProperties.Name="Chip colour hex value" />
                            <Button Grid.Column="2" x:Name="AppHoverSwatch" Style="{StaticResource Swatch}" ToolTip="Pick a colour" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,10"
                                   Text="The plain chip throws far less light than the holographic pane. Both show only while you point at the bar. The accent for the notification area, the clock and Start is on the Themes page." />
                    </StackPanel>

                    <!-- Notification area -->
                    <StackPanel x:Name="TrayPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Notification area" />

                        <CheckBox x:Name="TrayBox" Content="Host the notification area" Margin="0,0,0,2"
                                  ToolTip="Costs a permanent 100 ms timer that makes sure applications keep sending their icons to Umbra rather than to Windows. A missing icon appears once its application next updates it, or from Refresh tray icons in the bar's menu." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Shows notification icons next to the clock. Needs a restart." />

                        <!--
                            Which icons sit on the bar rather than behind the chevron. Not part of
                            settings.txt: the bar changes this list too, by dragging and from the
                            chevron's menu, so it lives in TrayChoice, which every one of them
                            shares. Each icon on the bar is lit area, dimmed as it is.
                        -->
                        <CheckBox x:Name="ShowAllTrayBox" Content="Show every icon on the bar" Margin="0,6,0,2"
                                  ToolTip="Nothing is kept behind the ^ menu. Right-click the ^ to switch back." />
                        <TextBlock x:Name="TrayChoiceHint" Style="{StaticResource Hint}"
                                   Text="Or choose them one by one. You can also drag an icon between the ^ menu and the bar. Every icon on the bar is lit, dimmed like the rest." />
                        <ScrollViewer x:Name="TrayIconScroller" MaxHeight="200"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="TrayIconList" />
                        </ScrollViewer>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" BorderBrush="{DynamicResource Umbra.Divider}" BorderThickness="0,1,0,0">
            <StackPanel Margin="18,12,18,14">
                <Grid>
                    <TextBlock x:Name="RestartNote" HorizontalAlignment="Left"
                               FontSize="11" Foreground="{DynamicResource Umbra.Warning}" TextWrapping="Wrap" MaxWidth="360" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Restart Umbra" x:Name="RestartButton" Padding="12,5" Margin="0,0,8,0" Click="OnRestartClick" />
                        <Button Content="Close" x:Name="CloseButton" Padding="16,5" IsCancel="True" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>

                <!--
                    How to leave, at the bottom where it is out of the way. A pointer rather than a
                    Remove button: the front page already has the steps in the order that cannot
                    strand a user without a taskbar, and a second copy of them here would drift.
                -->
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                    <Run Text="To go back to the Windows taskbar, right-click the bar → Exit Umbra. To remove Umbra completely, see" />
                    <Hyperlink Click="OnRemovalHelpClick"
                               Foreground="{DynamicResource Umbra.Text}"><Run Text="Getting your Windows taskbar back" /></Hyperlink>
                    <Run Text="on the front page." />
                </TextBlock>
            </StackPanel>
        </Border>

    </Grid>

</Window>
