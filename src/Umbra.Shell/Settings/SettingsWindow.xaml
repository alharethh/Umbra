<Window x:Class="Umbra.Shell.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Umbra — settings"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="#FF14140F"
        Foreground="#FFB6B6AD"
        TextOptions.TextRenderingMode="Grayscale"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB6B6AD" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A8A82" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,10" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#FFB6B6AD" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFB6B6AD" />
        </Style>

        <!--
            A full template, not just Background and Foreground setters. The window sets a light
            Foreground which inherits into the combo boxes, and WPF's stock ComboBox template draws
            its own light chrome regardless of Background — so the setters alone leave light-grey
            text on near-white, which is the least readable combination available. Verified by
            screenshotting the window rather than by assuming.
        -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFE0E0D8" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF33332B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFE0E0D8" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Face"
                                                Background="#FF23231E"
                                                BorderBrush="#FF3A3A33"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Fill="#FF9A9A90"
                                                  Data="M 0 0 L 7 0 L 3.5 4.5 Z" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#FF2C2C25" />
                                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF4A4A42" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter Margin="8,0,26,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />

                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   PopupAnimation="None"
                                   Focusable="False">
                                <Border Background="#FF1B1B16"
                                        BorderBrush="#FF3A3A33"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            The page list. A ListBox rather than buttons, so arrow keys move between pages and
            UI Automation reports one selected item, as Windows 11's own Settings does. The
            accent bar is the logo's cyan, on the one item that is selected.
        -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFB6B6AD" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <Border x:Name="Marker" Width="3" Height="16" CornerRadius="1.5"
                                    HorizontalAlignment="Left" Background="#FFB0F7FB" Visibility="Hidden" />
                            <Border x:Name="Focus" CornerRadius="4" BorderThickness="1"
                                    BorderBrush="#FFB0F7FB" Visibility="Hidden" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF1E1E19" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#FF26261F" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="#FFE8E4DA" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows' own icon font, so the page icons match Windows 11's Settings. -->
        <Style x:Key="NavGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Margin" Value="2,0,10,0" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFE8E4DA" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <!-- One row of a page: a label column of fixed width, then the control. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <!--
        A page list on the left and one page at a time on the right, as Windows 11's own Settings
        is laid out. The single column this replaced had reached a 150% laptop's work area, and
        every new setting made it scroll.

        All five pages share one grid cell and the ones not shown are Hidden, not Collapsed, so
        the cell is always as tall as the tallest page: the window is one size whichever page is
        open, and never jumps when the user moves between them.

        The page area scrolls and the footer does not. WorkAreaFit caps the window at its
        monitor's work area; under the cap the scroll bar never appears. Over it, Close and Restart
        stay in the window and the page scrolls instead of running off the screen.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#FF2E2E28" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" Margin="8,14,8,8"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource NavItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Settings pages">
                    <ListBoxItem AutomationProperties.Name="Bar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE90E;" />
                            <TextBlock Text="Bar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Wear">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE706;" />
                            <TextBlock Text="Wear" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Clock">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE823;" />
                            <TextBlock Text="Clock" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Hover">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE962;" />
                            <TextBlock Text="Hover" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem AutomationProperties.Name="Notification area">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE91C;" />
                            <TextBlock Text="Notification area" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Border>

            <ScrollViewer x:Name="Body" Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ScrollViewer.Resources>
                    <!--
                        Scoped to this viewer: the stock bar is light chrome on a dark window, the
                        same problem the ComboBox template above exists for. A thumb and nothing
                        else, like Windows 11's own overlay bars; the track either side still pages.
                    -->
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="10" />
                        <Setter Property="MinWidth" Value="10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border Background="#FF46463E" CornerRadius="3" Margin="3,2" />
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ScrollViewer.Resources>

                <Grid x:Name="Pages" Margin="22,16,22,10">

                    <!-- Bar -->
                    <StackPanel x:Name="BarPage">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Bar" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Screen edge" />
                            <ComboBox Grid.Column="1" x:Name="EdgeBox" AutomationProperties.Name="Screen edge" />
                        </Grid>

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Icon row" />
                            <ComboBox Grid.Column="1" x:Name="AlignmentBox" AutomationProperties.Name="Icon row" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Monitor" />
                            <ComboBox Grid.Column="1" x:Name="MonitorBox" AutomationProperties.Name="Monitor" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,14"
                                   Text="All three apply at once. Moving the bar makes maximised windows resize to fit, which is expected." />

                        <CheckBox x:Name="EveryMonitorBox" Content="A bar on every monitor" Margin="0,0,0,2"
                                  ToolTip="A non-OLED second screen pays for the dim resting state and the monochrome icons and gets nothing back. The notification area stays on the primary monitor either way." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Only worth it if every screen is OLED. Needs a restart." />

                        <CheckBox x:Name="StartupBox" Content="Start Umbra when I sign in" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="For your account only. You can also turn it off in Task Manager's Startup tab." />
                    </StackPanel>

                    <!-- Wear -->
                    <StackPanel x:Name="WearPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Wear" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resting icon size" />
                            <Slider Grid.Column="1" x:Name="IconSize" VerticalAlignment="Center"
                                    Minimum="12" Maximum="24" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Resting icon size"
                                    ValueChanged="OnIconSizeChanged" />
                            <TextBlock Grid.Column="2" x:Name="IconSizeReadout"
                                       MinWidth="104" TextAlignment="Right" FontFamily="Consolas" FontSize="11" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Resting brightness" />
                            <Slider Grid.Column="1" x:Name="Brightness" VerticalAlignment="Center"
                                    Minimum="10" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    AutomationProperties.Name="Resting brightness"
                                    ValueChanged="OnBrightnessChanged" />
                            <TextBlock Grid.Column="2" x:Name="BrightnessReadout"
                                       MinWidth="104" TextAlignment="Right" FontFamily="Consolas" FontSize="11" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,14"
                                   Text="Smaller and dimmer only at rest. Point at the bar and icons are full size and brightness." />

                        <CheckBox x:Name="MotionBox" Content="Drift and micro-jitter" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Moves the bar's contents inside their own slots, too slowly to see." />

                        <Grid Style="{StaticResource Row}" Margin="0,4,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Black when away" />
                            <ComboBox Grid.Column="1" x:Name="AwayBox" AutomationProperties.Name="Black when away" />
                            <StackPanel Grid.Column="2" x:Name="AwayCustom" Orientation="Horizontal"
                                        Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBox x:Name="AwaySeconds" Width="56"
                                         Background="#FF1B1B18" Foreground="#FFE8E4DA"
                                         BorderBrush="#FF3A3A33" BorderThickness="1"
                                         Padding="6,3" FontFamily="Consolas" TextAlignment="Right"
                                         AutomationProperties.Name="Black when away after this many seconds" />
                                <TextBlock Text="seconds" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,10"
                                   Text="Fades to black when there's no input. Stays lit while anything plays sound. Custom takes any number of seconds." />
                    </StackPanel>

                    <!-- Clock -->
                    <StackPanel x:Name="ClockPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Clock" />

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time format" />
                            <ComboBox Grid.Column="1" x:Name="ClockFormatBox" AutomationProperties.Name="Time format" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,10"
                                   Text="Follow Windows uses the format in Windows' region settings. On a left or right bar, a 12-hour clock leaves out AM and PM to fit." />
                    </StackPanel>

                    <!-- Hover -->
                    <StackPanel x:Name="HoverPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Hover" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Accent colour" />
                            <ComboBox Grid.Column="1" x:Name="AccentBox" AutomationProperties.Name="Accent colour" />
                            <Border Grid.Column="2" x:Name="AccentSwatch"
                                    Width="26" Height="18" HorizontalAlignment="Right"
                                    CornerRadius="3" BorderThickness="1" BorderBrush="#FF3A3A33" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Or a hex value" />
                            <TextBox Grid.Column="1" x:Name="AccentHex"
                                     Background="#FF1B1B18" Foreground="#FFE8E4DA"
                                     BorderBrush="#FF3A3A33" BorderThickness="1"
                                     Padding="6,3" FontFamily="Consolas"
                                     AutomationProperties.Name="Accent colour hex value" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,14"
                                   Text="For the notification area, the clock and Start. Capped to the brightest a hover may be, so this picks the hue, not the amount of light." />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Application icons" />
                            <ComboBox Grid.Column="1" x:Name="AppHoverBox" AutomationProperties.Name="Application icons hover" />
                        </Grid>

                        <Grid Style="{StaticResource Row}" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Chip colour" />
                            <TextBox Grid.Column="1" x:Name="AppHoverHex"
                                     Background="#FF1B1B18" Foreground="#FFE8E4DA"
                                     BorderBrush="#FF3A3A33" BorderThickness="1"
                                     Padding="6,3" FontFamily="Consolas"
                                     AutomationProperties.Name="Chip colour hex value" />
                            <Border Grid.Column="2" x:Name="AppHoverSwatch"
                                    Width="26" Height="18" HorizontalAlignment="Right"
                                    CornerRadius="3" BorderThickness="1" BorderBrush="#FF3A3A33" />
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Margin="140,2,0,10"
                                   Text="The plain chip throws far less light than the holographic pane. Both show only while you point at the bar." />
                    </StackPanel>

                    <!-- Notification area -->
                    <StackPanel x:Name="TrayPage" Visibility="Hidden">
                        <TextBlock Style="{StaticResource PageTitle}" Text="Notification area" />

                        <CheckBox x:Name="TrayBox" Content="Host the notification area" Margin="0,0,0,2"
                                  ToolTip="Costs a permanent 100 ms timer that makes sure applications keep sending their icons to Umbra rather than to Windows. A missing icon appears once its application next updates it, or from Refresh tray icons in the bar's menu." />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Shows notification icons next to the clock. Needs a restart." />
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" BorderBrush="#FF2E2E28" BorderThickness="0,1,0,0">
            <StackPanel Margin="18,12,18,14">
                <Grid>
                    <TextBlock x:Name="RestartNote" HorizontalAlignment="Left"
                               FontSize="11" Foreground="#FFC8B48A" TextWrapping="Wrap" MaxWidth="360" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Restart Umbra" x:Name="RestartButton" Padding="12,5" Margin="0,0,8,0" Click="OnRestartClick" />
                        <Button Content="Close" x:Name="CloseButton" Padding="16,5" IsCancel="True" Click="OnCloseClick" />
                    </StackPanel>
                </Grid>

                <!--
                    How to leave, at the bottom where it is out of the way. A pointer rather than a
                    Remove button: the front page already has the steps in the order that cannot
                    strand a user without a taskbar, and a second copy of them here would drift.
                -->
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                    <Run Text="To go back to the Windows taskbar, right-click the bar → Exit Umbra. To remove Umbra completely, see" />
                    <Hyperlink Click="OnRemovalHelpClick"
                               Foreground="#FFB6B6AD"><Run Text="Getting your Windows taskbar back" /></Hyperlink>
                    <Run Text="on the front page." />
                </TextBlock>
            </StackPanel>
        </Border>

    </Grid>

</Window>
