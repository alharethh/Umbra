<appbar:AppBarWindow x:Class="Umbra.Shell.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:appbar="clr-namespace:ManagedShell.AppBar;assembly=ManagedShell.AppBar"
        xmlns:render="clr-namespace:Umbra.Shell.Rendering"
        xmlns:tiers="clr-namespace:Umbra.Core.Tiers;assembly=Umbra.Core"
        x:ClassModifier="internal"
        Title="Umbra"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStyle="None"

        Background="#FF000000"

        AllowDrop="True"
        DragEnter="OnBarDragEnter"
        DragOver="OnBarDragOver"
        DragLeave="OnBarDragLeave"
        Drop="OnBarDrop"

        ToolTipService.InitialShowDelay="2400"
        ToolTipService.BetweenShowDelay="0"

        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="False"
        SnapsToDevicePixels="False">

    <!--
        The four rendering settings above are load-bearing and two of them fail silently (§5.2).

          TextFormattingMode="Ideal"    the Display default snaps glyphs to the pixel grid, which
                                       quantises the fractional micro-jitter the motion layer
                                       depends on. The bar looks like it is jittering correctly
                                       while doing nothing.
          TextRenderingMode="Grayscale" subpixel antialiasing puts fixed coloured fringes on fixed
                                       subpixels along every glyph edge — differential subpixel
                                       wear, at exactly the scale this project exists to prevent.
          UseLayoutRounding="False"
          SnapsToDevicePixels="False"   same reason as the first: no integer snapping anywhere on
                                        the path to the drifting content group.

        No ClearTypeHint is set anywhere, and none may be reintroduced further down the tree.
        Set here at step 1 so they are never wrong later, even though nothing drifts yet.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Rendering/MenuTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <render:TierIconConverter x:Key="TierIcon" Element="RunningIcon" />
        <render:TierIconConverter x:Key="TrayTierIcon" Element="TrayIcon" />
        <render:TierBrushConverter x:Key="IndicatorBrush" Element="RunningIndicator" />
        <render:TierBrushConverter x:Key="ClockBrush" Element="Clock" />
        <render:TierBrushConverter x:Key="StartGlyphBrush" Element="StartGlyph" />

        <!--
            One tray icon. Shared by the strip on the bar and by the overflow flyout, so an icon
            looks and behaves identically wherever it happens to be sitting.
        -->
        <!--
            Hover feedback for the small controls at the trailing end: a rounded wash that fades
            in under whatever is drawn, the same idea as the icon row's hover chip.

            Driven off the parent panel's IsMouseOver rather than its own, because the chip is
            not hit-testable — it sits behind the glyph and would otherwise fight it for the
            pointer. Faster in than out: appearing late reads as lag, and vanishing instantly
            reads as a flicker when the pointer crosses between two of them.

            It costs nothing that lasts. The wash is only ever drawn while the pointer is on the
            bar, which is Tier 2, and nothing is left lit when it fades.
        -->
        <!--
            Hover feedback: a holographic card rather than Windows' grey wash.

            A dark pane with a faint accent edge, a cyan glow, and a band of light that sweeps
            across it once on the way in. The sweep is a rectangle of gradient rotated 45 degrees
            and translated across the pane, clipped to it — the same construction as the CSS the
            project owner asked for, where a ::before element is rotated and slid on hover.

            Three things about it that are this bar rather than a web page:

            The accent is capped to the Tier 2 luminance ceiling (see BarWindow.AccentColor). A
            hover effect is the easiest place to smuggle something brighter than §2.3 allows past
            the budget, and this one lights pixels that were black.

            It runs only at Tier 2 — nothing here is ever drawn while the bar is dormant, so it is
            off the duty budget entirely.

            Every animated property belongs to an element inside this template, so each chip has
            its own. Sharing one Transform across elements is the failure that stopped the running
            indicator rendering at all.
        -->
        <Style x:Key="HolographicChip" TargetType="Control">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border x:Name="Pane"
                                CornerRadius="6"
                                Background="#FF0E1315"
                                BorderThickness="1"
                                ClipToBounds="True"
                                RenderTransformOrigin="0.5,0.5">

                            <Border.BorderBrush>
                                <SolidColorBrush Color="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 Opacity="0.28" />
                            </Border.BorderBrush>

                            <Border.RenderTransform>
                                <ScaleTransform x:Name="PaneScale" />
                            </Border.RenderTransform>

                            <Border.Effect>
                                <DropShadowEffect x:Name="Glow"
                                                  Color="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  BlurRadius="14"
                                                  ShadowDepth="0"
                                                  Opacity="0" />
                            </Border.Effect>

                            <!--
                                <b>On a Canvas, and that is load-bearing.</b> The sweep is oversized
                                on purpose — rotated 45 degrees it has to cover the pane's diagonal
                                at both ends of its travel — and ClipToBounds clips what is
                                *rendered*, not what is *measured*. As a direct child it asked
                                layout for 150 px and got it: the two controls with no fixed width,
                                the language indicator and the clock, grew to fit a rectangle
                                nobody can see, and the trailing group came apart. A Canvas reports
                                no desired size of its own, so the pane sizes to its host again.

                                Placed from the top-left rather than centred for the same reason:
                                centring is an alignment, and alignment needs a measured size.
                            -->
                            <Canvas ClipToBounds="True">
                            <Rectangle x:Name="Sweep"
                                       Width="150" Height="150"
                                       Canvas.Left="-58" Canvas.Top="-58"
                                       RenderTransformOrigin="0.5,0.5"
                                       Opacity="0.75">
                                <Rectangle.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="-45" />
                                        <TranslateTransform x:Name="SweepMove" Y="-110" />
                                    </TransformGroup>
                                </Rectangle.RenderTransform>

                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.34" Color="#0053E7FF" />
                                        <GradientStop Offset="0.50"
                                                      Color="{Binding AccentColor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <GradientStop Offset="0.66" Color="#0053E7FF" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            </Canvas>
                        </Border>

                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Panel}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.14" />

                                            <DoubleAnimation Storyboard.TargetName="PaneScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.06" Duration="0:0:0.22" />
                                            <DoubleAnimation Storyboard.TargetName="PaneScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.06" Duration="0:0:0.22" />

                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7" Duration="0:0:0.24" />

                                            <!-- One pass, on the way in, as the card does. -->
                                            <DoubleAnimation Storyboard.TargetName="SweepMove"
                                                             Storyboard.TargetProperty="Y"
                                                             From="-110" To="110" Duration="0:0:0.65" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>

                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.24" />
                                            <DoubleAnimation Storyboard.TargetName="PaneScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.24" />
                                            <DoubleAnimation Storyboard.TargetName="PaneScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.24" />
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.24" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SystemIndicatorTemplate">
            <Grid Background="Transparent"
                  Tag="ShellToggle"
                  AutomationProperties.Name="{Binding Title}"
                  AutomationProperties.AutomationId="TrayIcon"
                  ToolTip="{Binding Title}"
                  ToolTipService.Placement="{Binding TooltipPlacement, RelativeSource={RelativeSource AncestorType=Window}}"
                  MouseRightButtonDown="OnTrayIconMouseDown"
                  MouseRightButtonUp="OnTrayIconMouseUp"
                  MouseEnter="OnTrayIconMouseEnter"
                  MouseLeave="OnTrayIconMouseLeave"
                  Width="{Binding TraySlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  Height="{Binding TraySlotHeight, RelativeSource={RelativeSource AncestorType=Window}}">

                <Image Width="{Binding TrayIconExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                       Height="{Binding TrayIconExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransform="{Binding TrayOffset, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource TrayTierIcon}">
                            <Binding Path="Icon" />
                            <Binding Path="TierLevel" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrayIconTemplate">
            <Grid Background="Transparent"
                  Tag="ShellToggle"
                  AutomationProperties.Name="{Binding Title}"
                  AutomationProperties.AutomationId="TrayIcon"
                  ToolTip="{Binding Title}"
                  ToolTipService.Placement="{Binding TooltipPlacement, RelativeSource={RelativeSource AncestorType=Window}}"
                  MouseLeftButtonDown="OnTrayIconMouseDown"
                  MouseLeftButtonUp="OnTrayIconMouseUp"
                  MouseRightButtonDown="OnTrayIconMouseDown"
                  MouseRightButtonUp="OnTrayIconMouseUp"
                  MouseEnter="OnTrayIconMouseEnter"
                  MouseLeave="OnTrayIconMouseLeave"
                  Width="{Binding TraySlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                  Height="{Binding TraySlotHeight, RelativeSource={RelativeSource AncestorType=Window}}">

                <Control Style="{StaticResource HolographicChip}" Margin="2,6">
                    <Control.RenderTransform>
                        <TranslateTransform X="{Binding TrayOffset.X, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Y="{Binding TrayOffset.Y, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Control.RenderTransform>
                </Control>

                <Image Width="{Binding TrayIconExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                       Height="{Binding TrayIconExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       RenderTransform="{Binding TrayOffset, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Image.Source>
                        <MultiBinding Converter="{StaticResource TrayTierIcon}">
                            <Binding Path="Icon" />
                            <Binding Path="TierLevel" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                    </Image.Source>
                </Image>
            </Grid>
        </DataTemplate>

        <!-- A long pill for the foreground window, a short one for the rest, as Windows 11 does. -->
        <render:IndicatorWidthConverter x:Key="PillX" Horizontal="True" />
        <render:IndicatorWidthConverter x:Key="PillY" Horizontal="False" />
        </ResourceDictionary>
    </Window.Resources>

    <!--
        Background="Transparent" rather than unset: an unset background is not hit-testable, and
        without it the right-click never reaches the bar. Until there is a settings UI this menu
        is the only way out of the process, and needing Task Manager to stop a shell replacement
        that has hidden your taskbar is not an acceptable first-run experience.
    -->
    <Grid x:Name="ContentRoot" Background="Transparent">

        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource DarkContextMenu}">
                <MenuItem Header="Settings" Click="OnSettingsClick" Style="{StaticResource DarkMenuItem}" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="Refresh tray icons" Click="OnRefreshTrayClick" Style="{StaticResource DarkMenuItem}" />
                <MenuItem Header="Wear heatmap" Click="OnHeatmapClick" Style="{StaticResource DarkMenuItem}" />
                <MenuItem Header="Motion speed" Click="OnMotionSpeedClick" Style="{StaticResource DarkMenuItem}" />
                <Separator Style="{StaticResource MenuSeparatorStyle}" />
                <MenuItem Header="Exit Umbra" Click="OnExitClick" Style="{StaticResource DarkMenuItem}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!--
            The Start button. Its hit rectangle reaches the screen corner (§6.5) while the glyph
            draws at the Windows 11 inset — free, because hit geometry is invisible, and strictly
            better than Windows 11, which insets its own button and loses the corner as a target.

            Four filled squares in the Windows 11 arrangement, but neutral rather than the
            four-colour logo. §8 asked for an outline because "four saturated squares is the worst
            case" for the most temporally invariant element on the screen — the saturation was the
            expensive part, not the fill. A neutral glyph is carried by the white emitter (P4), and
            the tier system already holds it at #333333 while the pointer is away, so the filled
            version costs a little more lit area at a luminance that is already near the floor.
        -->
        <Grid x:Name="StartButton"
              Background="Transparent"
              AutomationProperties.Name="Start"
              ToolTip="Start"
              ToolTipService.Placement="{Binding TooltipPlacement}"
              MouseLeftButtonUp="OnStartClick"
              MouseRightButtonUp="OnStartContextMenu"
              HorizontalAlignment="{Binding StartHorizontalAlignment}"
              VerticalAlignment="{Binding StartVerticalAlignment}"
              Width="{Binding StartHitWidth}"
              Height="{Binding StartHitHeight}">

            <!--
                The same holographic pane the trailing controls get, centred on the glyph rather
                than on the hit rect — §6.5 deliberately extends the Start hit area to the screen
                corner, and a pane that filled it would be a large lit rectangle advertising
                invisible geometry.

                It drifts with the glyph, through its own TranslateTransform fed from the content
                offset. Its hover is the style's own, so the button no longer carries storyboards
                of its own; what stays the button's is the press animation and the Windows blue it
                takes while the menu is open, which happens after this and over the top of it.
            -->
            <Control x:Name="StartChip"
                     Style="{StaticResource HolographicChip}"
                     Width="30" Height="30"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="{Binding StartGlyphMargin}">
                <Control.RenderTransform>
                    <TranslateTransform X="{Binding ContentOffset.X}" Y="{Binding ContentOffset.Y}" />
                </Control.RenderTransform>
            </Control>

            <Canvas Width="24" Height="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="{Binding StartGlyphMargin}">

                <!--
                    Press feedback, plus the drift offset. The scale and rotation are animated from
                    code on click; the translate carries the same drift every other element gets,
                    bound through rather than shared, because a TransformGroup child cannot be the
                    shared transform instance itself.
                -->
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="StartScale" CenterX="12" CenterY="12" />
                        <RotateTransform x:Name="StartRotate" CenterX="12" CenterY="12" />
                        <TranslateTransform X="{Binding ContentOffset.X}" Y="{Binding ContentOffset.Y}" />
                    </TransformGroup>
                </Canvas.RenderTransform>

                <!--
                    Square corners and a thin cross: four 10.7 px squares separated by 0.8 px,
                    filling 22.2 of the 24 px box.

                    Both numbers were arrived at by rendering candidates at true size against the
                    real logo rather than by adjusting one at a time. Rounded corners and a wide
                    gutter both push it away from reading as Start — rounding softens a 10 px square
                    into a blob, and a wide gutter turns the shape into a grid of four tiles.

                    The 0.8 px gap is one whole physical pixel at 125% scaling, which is as thin as
                    it can be and still be a gap. It will antialias as the glyph drifts, which is
                    intended: fractional positioning is what varies the edge gradient (§6.1).
                -->
                <Canvas.Resources>
                    <Style TargetType="Rectangle">
                        <Setter Property="Width" Value="10.7" />
                        <Setter Property="Height" Value="10.7" />
                        <Setter Property="Fill"
                                Value="{Binding TierLevel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource StartGlyphBrush}}" />
                    </Style>
                </Canvas.Resources>

                <Rectangle Canvas.Left="0.9"  Canvas.Top="0.9" />
                <Rectangle Canvas.Left="12.4" Canvas.Top="0.9" />
                <Rectangle Canvas.Left="0.9"  Canvas.Top="12.4" />
                <Rectangle Canvas.Left="12.4" Canvas.Top="12.4" />

                <!--
                    The blue layer. Drawn over the grey glyph and faded in rather than swapped for
                    it, because a brush that changes colour outright reads as a glitch. Sharing the
                    parent Canvas means it inherits the drift and the press animation for free.
                -->
                <Canvas x:Name="StartBlue" Width="24" Height="24"
                        Canvas.Left="0" Canvas.Top="0"
                        IsHitTestVisible="False">
                    <!--
                        <b>The blue arrives with the sweep, not with the pointer.</b> It used to
                        fade in over 130 ms the instant the button was hovered, which put it well
                        ahead of the band of light crossing the pane behind it — the logo was
                        already blue by the time the thing supposedly colouring it arrived.

                        So the layer is drawn at full opacity and revealed through a mask instead:
                        a gradient running corner to corner, white before the front and clear after
                        it, with both stops walked from off one corner to off the other. What the
                        eye sees is the blue being laid down by the light as it passes.

                        The mask's axis is the pane's: StartPoint 0,0 to EndPoint 1,1 is top-left
                        to bottom-right, which is the direction the sweep travels, and the duration
                        is the sweep's 0.65 s so the two stay together.

                        <b>Masking rather than a second fade is also what keeps it clean.</b> A
                        blue copy faded in over the grey one draws both at once, and two
                        anti-aliased edges on the same sub-pixel position composite into something
                        heavier and fringed — that is what killed the accent tint on the trailing
                        glyphs. Here the mask hides the blue everywhere the grey is doing the work,
                        so the two are never both solid in the same place.
                    -->
                    <Canvas.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFFFF" Offset="-0.35" />
                            <GradientStop Color="#00FFFFFF" Offset="-0.12" />
                        </LinearGradientBrush>
                    </Canvas.OpacityMask>

                    <Canvas.Style>
                        <Style TargetType="Canvas">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StartHighlighted, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <!--
                                                    Reached by property path, not by name: a Style
                                                    trigger has no name scope to resolve a
                                                    TargetName against, and the compiler says so.
                                                -->
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                                 To="1.12" Duration="0:0:0.65" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                                 To="1.35" Duration="0:0:0.65" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[0].(GradientStop.Offset)"
                                                                 To="-0.35" Duration="0:0:0.28" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[1].(GradientStop.Offset)"
                                                                 To="-0.12" Duration="0:0:0.28" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Canvas.Style>

                    <Canvas.Resources>
                        <Style TargetType="Rectangle">
                            <Setter Property="Width" Value="10.7" />
                            <Setter Property="Height" Value="10.7" />
                            <Setter Property="Fill"
                                    Value="{Binding StartAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </Canvas.Resources>

                    <Rectangle Canvas.Left="0.9"  Canvas.Top="0.9" />
                    <Rectangle Canvas.Left="12.4" Canvas.Top="0.9" />
                    <Rectangle Canvas.Left="0.9"  Canvas.Top="12.4" />
                    <Rectangle Canvas.Left="12.4" Canvas.Top="12.4" />
                </Canvas>
            </Canvas>
        </Grid>

        <!--
            The drifting content group, once §6 lands. Everything inside it moves together; the
            hit slots underneath do not move at all (P5).
        -->
        <ItemsControl x:Name="WindowList"
                      AutomationProperties.Name="Open and pinned applications"
                      ItemsSource="{Binding Slots}"
                      HorizontalAlignment="{Binding RowHorizontalAlignment}"
                      VerticalAlignment="{Binding RowVerticalAlignment}"
                      Width="{Binding RowWidth}"
                      Height="{Binding RowHeight}"
                      Margin="{Binding RowMargin}">

            <!--
                A sliding panel, not a StackPanel: reordering the row moves icons between slots,
                and doing that instantaneously reads as a glitch rather than as a move. It arranges
                identically and animates the difference. See SlidingStackPanel for why its easing
                is not a breach of §6.1.
            -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <render:SlidingStackPanel Orientation="{Binding RowOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                        This Grid is the hit slot. Per P5 it is computed from the undrifted layout
                        and never moves: only the content inside it drifts, so a click always lands
                        where the user sees the icon.

                        A reorder does move it — that is the point of a reorder — but the slot and
                        its content move together, as one, so the drift never leaves its own slot
                        and the click target never leaves the icon.
                    -->
                    <Grid Background="Transparent"
                          AutomationProperties.Name="{Binding DisplayName}"
                          AutomationProperties.HelpText="{Binding Title}"
                          AutomationProperties.AutomationId="TaskbarSlot"
                          MouseEnter="OnSlotMouseEnter"
                          MouseLeave="OnSlotMouseLeave"
                          MouseLeftButtonDown="OnSlotMouseDown"
                          MouseMove="OnSlotMouseMove"
                          MouseLeftButtonUp="OnSlotClick"
                          LostMouseCapture="OnSlotLostCapture"
                          ContextMenuOpening="OnSlotContextMenuOpening"
                          Width="{Binding SlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                          Height="{Binding SlotHeight, RelativeSource={RelativeSource AncestorType=Window}}">

                        <!--
                            No tooltip while the application is running: hovering already raises a
                            preview whose header carries the window title, and a tooltip repeating
                            it is a second label for the same fact. A pinned application that is not
                            running has no preview, so there it is the only thing naming the icon.
                        -->
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="ToolTip" Value="{Binding Title}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Grid.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverChip"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.12">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="Grid.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverChip"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.4">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>

                        <Grid.ContextMenu>
                            <!--
                                Built in code as it opens - see BarWindow.OnSlotContextMenuOpening.
                                Its contents depend on what the application publishes in its jump
                                list, which is read from disk and cannot be expressed here.
                            -->
                            <ContextMenu Style="{StaticResource DarkContextMenu}" />
                        </Grid.ContextMenu>

                        <!--
                            Hover affordance. Drawn behind the icon and drifting with it, so the
                            two stay concentric and the chip never advertises the drift (P6).

                            It costs light only while the pointer is on the bar, which is Tier 2 at
                            ~0.1% duty (§3.2), and #1F1F1A is L = 1.2% — about a thousandth of the
                            wear of a white hover. The fade timings are §3.4's: 120 ms attack so it
                            feels immediate, 400 ms release so crossing the row does not strobe.
                        -->
                        <Rectangle x:Name="HoverChip"
                                   RadiusX="5" RadiusY="5"
                                   Fill="{Binding AppIconHoverBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Opacity="0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding AppIconChipVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Width="{Binding HoverChipExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding HoverChipExtent, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Rectangle.RenderTransform>
                                <TranslateTransform
                                    X="{Binding ContentOffset.X, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Y="{Binding ContentOffset.Y, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Rectangle.RenderTransform>
                        </Rectangle>

                        <!--
                            The other choice: the notification area's holographic pane, on the row.

                            Both are built for every slot and one of them is collapsed, so changing
                            the setting is a visibility flip rather than a retemplate. Retemplating
                            would rebuild the slot containers, and a container that is destroyed and
                            recreated has nowhere to slide from — which is what makes drag-reorder
                            animate at all.
                        -->
                        <Control Style="{StaticResource HolographicChip}"
                                 Visibility="{Binding AppIconPaneVisibility, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Width="{Binding HoverChipExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Height="{Binding HoverChipExtent, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Control.RenderTransform>
                                <TranslateTransform
                                    X="{Binding ContentOffset.X, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Y="{Binding ContentOffset.Y, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Control.RenderTransform>
                        </Control>

                        <!--
                            The icon is rebuilt for the current tier level: monochrome and
                            normalised so its P90 lands on the tier target at rest, cross-fading
                            to luminance-capped full chroma at Tier 2 (§3.1, §3.2, §5.1).

                            RenderTransform, not LayoutTransform: the offset is fractional and must
                            stay fractional. A layout pass would round it to the pixel grid and
                            quietly destroy the sub-pixel micro-jitter the whole motion layer rests
                            on (§5.2, §6.1).
                        -->
                        <Image x:Name="SlotIcon"
                               Width="{Binding IconExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                               Height="{Binding IconExtent, RelativeSource={RelativeSource AncestorType=Window}}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               RenderTransformOrigin="0.5,0.5">

                            <!--
                                Press feedback composed with the drift, rather than replacing it.
                                The scale is animated from code; the translate carries the same
                                offset every other element gets.
                            -->
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <TranslateTransform
                                        X="{Binding ContentOffset.X, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Y="{Binding ContentOffset.Y, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </TransformGroup>
                            </Image.RenderTransform>

                            <Image.Source>
                                <MultiBinding Converter="{StaticResource TierIcon}">
                                    <Binding Path="Icon" />
                                    <Binding Path="TierLevel" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    <!-- The slot, so the converter can report its icon's cost once. -->
                                    <Binding />
                                </MultiBinding>
                            </Image.Source>
                        </Image>

                        <!--
                            Running indicator. Hidden at Tier 0 — TierPalette resolves it to black,
                            which against a black bar costs nothing at all (P1) — and fading up
                            through the proximity ramp is the most visible sign the tier system is
                            alive.
                        -->
                        <Rectangle RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="{Binding PillHorizontalAlignment, RelativeSource={RelativeSource AncestorType=Window}}"
                                   VerticalAlignment="{Binding PillVerticalAlignment, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Margin="{Binding PillMargin, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Fill="{Binding TierLevel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource IndicatorBrush}}">

                            <!--
                                Its own TranslateTransform, fed the same values, rather than the
                                shared ContentOffset instance. Assigning one Transform to every
                                slot's rectangle stopped them rendering at all — the widths and the
                                fill were both correct and nothing was drawn. Each element gets its
                                own, as the icon and the Start glyph already do.
                            -->
                            <Rectangle.RenderTransform>
                                <TranslateTransform
                                    X="{Binding PillOffset.X, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Y="{Binding PillOffset.Y, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Rectangle.RenderTransform>

                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource PillX}">
                                    <Binding Path="IsRunning" />
                                    <Binding Path="IsActive" />
                                    <Binding Path="IsVertical" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </Rectangle.Width>
                            <Rectangle.Height>
                                <MultiBinding Converter="{StaticResource PillY}">
                                    <Binding Path="IsRunning" />
                                    <Binding Path="IsActive" />
                                    <Binding Path="IsVertical" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </Rectangle.Height>
                        </Rectangle>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            The trailing group: notification area, then the clock at the very end (§7.1).
        -->
        <StackPanel Orientation="{Binding RowOrientation}"
                    HorizontalAlignment="{Binding TrayHorizontalAlignment}"
                    VerticalAlignment="{Binding TrayVerticalAlignment}"
                    Margin="{Binding TrayMargin}">

        <!--
            The overflow chevron (§7.1). Hidden entirely when nothing is behind it, because a
            permanently lit affordance opening an empty panel is a lit pixel for nothing.
        -->
        <Grid x:Name="TrayChevron" Tag="ShellToggle"
              Background="Transparent"
              ToolTip="Show hidden icons"
              ToolTipService.Placement="{Binding TooltipPlacement}"
              Visibility="{Binding TrayOverflowVisibility}"
              MouseLeftButtonUp="OnTrayChevronClick"
              VerticalAlignment="Center"
              Width="{Binding TraySlotWidth, RelativeSource={RelativeSource AncestorType=Window}}"
              Height="{Binding TraySlotHeight, RelativeSource={RelativeSource AncestorType=Window}}">

            <Control Style="{StaticResource HolographicChip}" Margin="2,6">
                <Control.RenderTransform>
                    <TranslateTransform X="{Binding TrayOffset.X, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Y="{Binding TrayOffset.Y, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Control.RenderTransform>
            </Control>

            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="TrayChevronScale" />
                </Grid.RenderTransform>

                <Path x:Name="TrayChevronGlyph"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Data="M 0,4 L 4.5,0 L 9,4"
                      Stretch="Uniform"
                      Width="{Binding TrayChevronWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                      Height="{Binding TrayChevronHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                      StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding TierLevel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ClockBrush}}"
                      RenderTransform="{Binding TrayOffset, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Grid>
        </Grid>

        <!--
            The system cluster: the pinned indicators and the network glyph, as one control.

            Windows 11 has a single button here covering volume, network and battery, and it opens
            Quick Settings. Splitting them gave two hover chips side by side with a dead hairline
            between, which is not what the row is.

            Its slots are smaller than the icon row's, so it uses its own derived drift amplitude —
            applying the row's would push these out of their slots and break P5.
        -->
        <Grid x:Name="SystemCluster" Tag="ShellToggle"
              Background="Transparent"
              Visibility="{Binding SystemClusterVisibility}"
              AutomationProperties.Name="{Binding NetworkDescription}"
              AutomationProperties.HelpText="Opens Quick Settings"
              ToolTip="{Binding NetworkDescription}"
              ToolTipService.Placement="{Binding TooltipPlacement}"
              MouseLeftButtonUp="OnSystemClusterClick"
              VerticalAlignment="Center">

            <Control Style="{StaticResource HolographicChip}" Margin="1,6">
                <Control.RenderTransform>
                    <TranslateTransform X="{Binding TrayOffset.X}" Y="{Binding TrayOffset.Y}" />
                </Control.RenderTransform>
            </Control>

            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="SystemClusterScale" />
                </Grid.RenderTransform>

                <StackPanel Orientation="{Binding RowOrientation}">

                    <ItemsControl x:Name="TrayHost"
                                  AutomationProperties.Name="Notification area"
                                  ItemsSource="{Binding TrayIcons}"
                                  VerticalAlignment="Center">

                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="{Binding RowOrientation, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <StaticResource ResourceKey="SystemIndicatorTemplate" />
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        The network indicator. Drawn rather than hosted, because Windows 11 never
                        sends one as a notification icon — NETWORK_GUID has never appeared in the
                        stream on any run, while VOLUME_GUID does. Stroked so it takes the tier
                        brush like the chevron; a bitmap would have to go through the monochrome
                        normaliser instead.
                    -->
                    <Grid x:Name="NetworkIndicator"
                          VerticalAlignment="Center"
                          Width="{Binding TraySlotWidth}"
                          Height="{Binding TraySlotHeight}">

                        <Path Data="{Binding NetworkGlyph}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Stretch="Uniform"
                              Width="{Binding TrayIconExtent}"
                              Height="{Binding TrayIconExtent}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{Binding TierLevel, Converter={StaticResource ClockBrush}}"
                              RenderTransform="{Binding NetworkOffset}" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>

            <!--
                The input language indicator — the NOB or ENG the Windows taskbar shows. Not a
                notification icon: it is the Text Services Framework input indicator, which no
                amount of tray work would ever have produced, so we draw it ourselves.

                Collapsed unless more than one language is installed, exactly as Windows hides
                its own. Clicking it switches the foreground window to the next one.
            -->
            <Grid x:Name="LanguageIndicator"
                  Background="Transparent"
                  ToolTip="Switch input language"
                  ToolTipService.Placement="{Binding TooltipPlacement}"
                  Visibility="{Binding LanguageVisibility}"
                  MouseLeftButtonUp="OnLanguageClick"
                  VerticalAlignment="Center"
                  Height="{Binding TraySlotHeight}"
                  Margin="6,0,0,0">

                <!--
                    Full band height, like every other control in this group. Sized to its text it
                    was as short as the glyphs are tall and half again as wide, so the chip came
                    out a letterbox rather than a key.
                -->
                <Control Style="{StaticResource HolographicChip}" Margin="0,6">
                    <Control.RenderTransform>
                        <TranslateTransform X="{Binding LanguageOffset.X}" Y="{Binding LanguageOffset.Y}" />
                    </Control.RenderTransform>
                </Control>

                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LanguageScale" />
                    </Grid.RenderTransform>

                    <TextBlock Text="{Binding LanguageName}"
                               FontSize="12"
                               Margin="7,0"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{Binding TierLevel, Converter={StaticResource ClockBrush}}"
                               RenderTransform="{Binding LanguageOffset}" />
                </Grid>
            </Grid>

            <!--
                The clock. No seconds at any tier (§6.4) — a ticking seconds field is
                high-frequency change in a tiny fixed area with almost no informational value — and
                the colon does not blink. The date appears from Tier 1 upward.

                Drifts with everything else but jitters on its own frequencies, because digits
                change while digit *positions* do not, and the colon never changes at all.
            -->
            <Grid Background="Transparent"
                  Tag="ShellToggle"
                  AutomationProperties.Name="{Binding ClockAutomationName}"
                  AutomationProperties.HelpText="{Binding ClockAutomationHelp}"
                  ToolTip="{Binding ClockTooltip}"
                  ToolTipService.Placement="{Binding TooltipPlacement}"
                  MouseLeftButtonUp="OnClockClick"
                  Margin="{Binding ClockMargin}"
                  Height="{Binding TraySlotHeight}"
                  VerticalAlignment="Center">

                <!--
                    Fixed to the band rather than to the text, or the chip is the height of the
                    time alone until the date appears — and the date appears at the same instant
                    the pointer arrives, so the chip was always one layout pass behind the thing
                    it was meant to be behind.
                -->
                <Control Style="{StaticResource HolographicChip}" Margin="-7,6">
                    <Control.RenderTransform>
                        <TranslateTransform X="{Binding ClockOffset.X}" Y="{Binding ClockOffset.Y}" />
                    </Control.RenderTransform>
                </Control>

                <Grid RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ClockScale" />
                    </Grid.RenderTransform>

                <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        MinWidth="{Binding ClockMinWidth}"
                        RenderTransform="{Binding ClockOffset}">

                <TextBlock x:Name="ClockTimeText"
                           Text="{Binding ClockTime}"
                           FontSize="14"
                           TextAlignment="Center"
                           Foreground="{Binding TierLevel, Converter={StaticResource ClockBrush}}" />

                <TextBlock Text="{Binding ClockDate}"
                           FontSize="10"
                           TextAlignment="Center"
                           Opacity="0.75"
                           Foreground="{Binding TierLevel, Converter={StaticResource ClockBrush}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsDate}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </StackPanel>
                </Grid>
            </Grid>
        </StackPanel>

        <!--
            Show desktop. The sliver in the trailing corner of the Windows taskbar: click to
            minimise everything, click again to put it back.

            A sibling of the trailing group rather than a child of it, so its hit area reaches
            the screen corner — the one target a pointer can hit without aiming. It occupies the
            margin the row already holds back for drift (§6.3), so it takes no space from the
            clock. The hairline is drawn inboard of that inset, where it cannot clip, and only
            from Tier 1: a permanently lit column in a fixed position is what §2.3 exists to
            refuse, and the control works whether or not it can be seen.
        -->
        <Grid x:Name="ShowDesktop"
              Background="Transparent"
              AutomationProperties.Name="Show desktop"
              ToolTip="Show desktop"
              ToolTipService.Placement="{Binding TooltipPlacement}"
              MouseLeftButtonUp="OnShowDesktopClick"
              HorizontalAlignment="{Binding ShowDesktopHorizontalAlignment}"
              VerticalAlignment="{Binding ShowDesktopVerticalAlignment}"
              Width="{Binding ShowDesktopHitWidth}"
              Height="{Binding ShowDesktopHitHeight}">

            <!--
                Narrow on purpose. The hit area runs to the screen corner, but a pane that wide
                would be a slab beside a 1 px line — this is about as wide as the line is long, so
                it reads as the line acquiring a surface rather than as a button appearing.
            -->
            <Control Style="{StaticResource HolographicChip}" Margin="12,6" />

            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="ShowDesktopScale" />
                </Grid.RenderTransform>

            <Rectangle Width="{Binding ShowDesktopLineWidth}"
                       Height="{Binding ShowDesktopLineHeight}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.35"
                       Fill="{Binding TierLevel, Converter={StaticResource ClockBrush}}">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowsShowDesktopLine}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                            <!--
                                The line itself is the feedback here, rather than the wash the
                                other trailing controls use. A chip the size of this hit area is a
                                slab against a 1 px line, and the control is a hairline by design:
                                it should brighten, not acquire a body.
                            -->
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Panel}}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1.0"
                                                             Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.35"
                                                             Duration="0:0:0.20" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>
            </Grid>
        </Grid>

        <!--
            The overflow flyout. A Popup rather than a window so it follows the chevron as the bar
            moves between edges, and AllowsTransparency so its corners can be rounded against
            whatever is behind it.

            StaysOpen is true and dismissal is driven by the pointer watcher in code-behind. WPF
            closes a popup by capturing the mouse and watching for a click outside, and the bar
            carries WS_EX_NOACTIVATE — so that capture is not honoured across processes and the
            flyout would sit open until you clicked back inside Umbra. The window picker and the
            context menus solve it the same way, for the same reason.
        -->
        <Popup x:Name="TrayOverflowPopup"
               PlacementTarget="{Binding ElementName=TrayChevron}"
               Placement="Custom"
               AllowsTransparency="True"
               StaysOpen="True"
               PopupAnimation="None">

            <Border Background="#F21C1C18"
                    ToolTipService.InitialShowDelay="2400"
                    ToolTipService.BetweenShowDelay="0"
                    BorderBrush="#FF3A3A33"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="6"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270"
                                      Opacity="0.55" Color="#FF000000" />
                </Border.Effect>

                <ItemsControl x:Name="TrayOverflowHost"
                              AutomationProperties.Name="Hidden notification icons"
                              ItemsSource="{Binding OverflowTrayIcons}"
                              ItemTemplate="{StaticResource TrayIconTemplate}">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--
                                As wide as it is full, wrapping at five across — how Windows 11
                                lays its own overflow out. A fixed five left a short row huddled
                                at one end of an empty panel.
                            -->
                            <UniformGrid Columns="{Binding TrayOverflowColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>

</appbar:AppBarWindow>
