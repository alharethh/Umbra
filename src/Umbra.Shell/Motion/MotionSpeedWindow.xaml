<Window x:Class="Umbra.Shell.Motion.MotionSpeedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Umbra — motion speed"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        Background="#FF14140F"
        Foreground="#FFB6B6AD"
        TextOptions.TextRenderingMode="Grayscale"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="18">

        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                   Text="Winds motion time forward so the drift becomes visible. At 1x there is nothing to see — that is the design intent, not a fault. The icons still never leave their own click areas at any speed." />

        <TextBlock x:Name="Readout"
                   FontFamily="Consolas" FontSize="20"
                   Margin="0,18,0,2" />

        <TextBlock x:Name="Detail"
                   FontFamily="Consolas" FontSize="12"
                   Opacity="0.75" Margin="0,0,0,10" />

        <Slider x:Name="Speed"
                Minimum="0" Maximum="1"
                Value="0"
                TickFrequency="0.05"
                IsSnapToTickEnabled="False"
                ValueChanged="OnSpeedChanged" />

        <Grid Margin="0,4,0,0">
            <TextBlock Text="1x  (real time)" FontSize="11" Opacity="0.55" HorizontalAlignment="Left" />
            <TextBlock Text="2000x" FontSize="11" Opacity="0.55" HorizontalAlignment="Right" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Back to real time" Padding="12,5" Click="OnResetClick" />
            <TextBlock x:Name="WearNote" Margin="14,0,0,0" VerticalAlignment="Center"
                       FontSize="11" Opacity="0.7" />
        </StackPanel>

    </StackPanel>

</Window>
